# Paste your Neon pooled connection string here. Never use NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL=
# Optional hero clips. Use /videos/hero-intro.mp4 for files in public/videos/.
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_IDLE_VIDEO_URL=
# Restart npm run dev after changing this file.
# Empty DATABASE_URL uses persistent local demo storage in .demo/.
